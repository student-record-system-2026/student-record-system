# Copy this file to backend/.env and adjust for your machine.

# HTTP port for the API server (the Vite dev server proxies /api to this port).
PORT=4000

# Main (development/demo) database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_record_system

# Separate database used ONLY by the automated test suite (it is wiped and re-seeded on every run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_record_system_test

# Secret used to sign the session cookie. Use a long random value outside local development.
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in minutes.
SESSION_TTL_MINUTES=480

# Set to true only when served over HTTPS (SRS 3.4); keeps the session cookie HTTPS-only.
COOKIE_SECURE=false

# bcrypt work factor for password hashing (NFR-2).
BCRYPT_ROUNDS=10
